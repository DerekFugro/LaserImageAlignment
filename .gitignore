# --- environments and caches (rebuildable, and machine-specific) ---
# .venv stores ABSOLUTE paths written when it was created, so it cannot work on
# another machine even if copied. launch.bat detects a foreign one and rebuilds.
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/

# --- bundled offline wheels (569 MB) ---
# NOT junk, and NOT optional to understand before deleting them: this folder is
# what lets launch.bat build the environment with NO INTERNET, and core/geotag.py
# installs piexif from here when a venv predates it being added to
# requirements.txt.
#
# Kept out of git because GitHub rejects any file over 100 MB and warns over 50,
# and pyside6_addons alone is ~160 MB - the push would fail partway through.
# If this repo is cloned somewhere else, either copy wheels/ across by hand or
# just let uv/pip fetch the same packages from PyPI (which needs internet).
wheels/

# --- per-installation settings ---
# lia.ini holds THIS machine's paths. It is deliberately NOT tracked: it was,
# until 2026-09-10, and that meant anyone who cloned the repo and set their own
# calibrations folder had a locally-modified tracked file - so every `git pull`
# afterwards either refused or turned into a merge conflict over a settings
# file. `lia.ini.example` is the tracked template; the launchers copy it on
# first run.
lia.ini

# --- app output, not source ---
Exports/

# --- editor / OS noise ---
.vscode/
.idea/
Thumbs.db
desktop.ini
*.swp
*~

# NOTE ON WHAT IS DELIBERATELY *NOT* IGNORED:
#   lia.ini.example            - the template a fresh clone gets. The launchers
#                                copy it to lia.ini, which IS ignored (above).
#   uv.lock                    - pins the dependency set; belongs in the repo.
#   capture_times_20260817.csv - the only surviving record of the original file
#                                timestamps, which geotagging destroys.
#
# Collected data (F:\Sidewalk\099_CollectedData\...) and the calibrations folder
# live OUTSIDE this folder and are never part of this repo. Nothing from
# 099_CollectedData, SBGData/ or AllCalibrations/ should ever be committed here.
